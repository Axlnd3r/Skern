# Copy to .env and fill in. .env is git-ignored: never commit it, never paste a key into an issue or a log.
# These are read from the process environment only (load .env with your shell or runner; the code has no dotenv).

# --- Chain (Base Sepolia testnet only; points only, no real money) ---
RPC_URL=https://sepolia.base.org
# 84532 (Base Sepolia) or 31337 (local anvil). Anything else is refused.
CHAIN_ID=84532
# Arena from shared/addresses.json (Base Sepolia deployment). Block 63274211 is the deployBlock for log scans.
ARENA_ADDRESS=0x4Da1FBb0f99D27F566Aa08243A4D6B8276E69AB7

# --- The keeper wallet ---
# Must be the address stored in Arena.keeper() (shared/addresses.json "keeper"); the keeper refuses to start otherwise.
# A different wallet from the deployer. Fund it with a little Base Sepolia ETH (about 3M gas per freezeAll/postCandles).
# Never logged, never written to disk.
KEEPER_PRIVATE_KEY=

# --- Price data: Alpaca Market Data, free Basic plan, IEX feed (decision D4) ---
# Only basis-point moves relative to P0 are posted or logged; raw prices are never published (Alpaca forbids redistribution).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- Demo round (5-minute candles; commit 90 s, reveal 30 s, market 60 s) ---
# DEMO_TICKER=AAPL
# DEMO_ENTRY_STAKE=10
# Run a labeled "replay" round outside the US session: seconds to shift a past session into the present
# (for example 86400 for the same time yesterday on a weekday). Present it as a mechanism demo, never as a live prediction.
# DEMO_REPLAY_OFFSET_SEC=
# Anvil only: mine one block per tick so chain time advances (or start anvil with --block-time 1).
# MINE_ON_TICK=1

# --- State and relay ---
# Keeper state (planned/open rounds, ids) and the relay queue (clear-text salts until reveal). Default: ~/.consensus-path/keeper
# KEEPER_STATE_DIR=
# Reveal relay: POST /reveal, GET /health
# RELAY_PORT=8787
# RELAY_HOST=127.0.0.1
# Comma-separated exact browser origins allowed to call the relay (CORS), for example the public app URL
# RELAY_ALLOW_ORIGIN=
