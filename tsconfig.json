{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "keeper/**/*.ts", "agents/**/*.ts"],
  "exclude": ["node_modules", "contracts/lib", "app"]
}
