# Copy to contracts/.env and fill in. contracts/.env is gitignored; never commit real values.
# Network: Base Sepolia (chain id 84532) only. Testnet funds only.

# Deployer / owner key (0x + 64 hex). Use a NEW throwaway wallet that holds only testnet ETH.
# Never reuse a wallet that holds real funds.
PRIVATE_KEY=

# Address that becomes Arena's keeper. Set-once and permanent, so double-check it.
# Preferably a different address than the deployer (the keeper's key will live on a server later).
KEEPER_ADDRESS=

# Base Sepolia RPC. The public endpoint is rate limited; use a provider URL if it fails.
# foundry.toml defines no rpc alias, so pass it by hand: forge script script/Deploy.s.sol --rpc-url $BASE_SEPOLIA_RPC_URL --chain-id 84532 --broadcast
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan API key for contract verification. foundry.toml has no [etherscan] section, so pass it by hand: forge verify-contract ... --etherscan-api-key $BASESCAN_API_KEY
BASESCAN_API_KEY=
