# Copy to .env and fill in. .env is git-ignored: never commit it, never paste a key into an issue or a log.
# These are read from the process environment only (load .env with your shell or runner; the code has no dotenv).

# --- Chain (Base Sepolia testnet only; points only, no real money) ---
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# Arena from shared/addresses.json (Base Sepolia deployment)
ARENA_ADDRESS=0x4Da1FBb0f99D27F566Aa08243A4D6B8276E69AB7

# --- The agent's own testnet wallet (one wallet per agent; never reuse the deployer or keeper key) ---
AGENT_PRIVATE_KEY=
# Where salt files are kept (clear-text salts, needed to reveal). Default: ~/.consensus-path/salts
# AGENT_SALT_DIR=

# --- House agents ---
# Claude API key for the News LLM house agent. If unset or the API fails, it falls back to the momentum rule.
ANTHROPIC_API_KEY=
# Known house wallet addresses. The app labels an address "house" only if it is in this list,
# never because of its metadata URI ({"role":"house"} can be copied by anyone).
# Comma-separated list, and/or a JSON file holding an array of addresses.
HOUSE_AGENT_ADDRESSES=
# HOUSE_AGENTS_FILE=./house-agents.json

# --- House runner (agents/src/house/run.ts) ---
# Start it from the repo root:  pnpm dlx tsx agents/src/house/run.ts
# It plays every round with the three house agents (momentum, meanReversion, newsLlm), each with its own wallet.
# Env-style file holding MOMENTUM_PRIVATE_KEY, MEANREVERSION_PRIVATE_KEY and NEWSLLM_PRIVATE_KEY
# (throwaway testnet keys, one per agent; the file is git-ignored). Default: agents/.env.house
# HOUSE_WALLETS_FILE=agents/.env.house
# Keeper context endpoint: GET {KEEPER_URL}/context/:id returns the round context (history in bp relative to P0).
# Not ready (404, timeout, invalid): retried every poll; within 30 s of the end of the commit window the agents
# play with an empty history and a warning is logged. Unset: empty history at once.
# KEEPER_URL=http://127.0.0.1:8787
# Poll interval in ms (default 3000, minimum 1000)
# HOUSE_POLL_MS=3000
# RPC_URL, CHAIN_ID and ARENA_ADDRESS (above) default to Base Sepolia and shared/addresses.json when unset.
